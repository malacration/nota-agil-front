# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NG_CLI_ANALYTICS=false
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=nota-agil-hmg-npm,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY . .
RUN npm run build -- --configuration production

FROM nginx:stable-alpine
COPY --from=build /app/dist/nota-agil-ng/browser/ /usr/share/nginx/html/
COPY docker/hmg/nginx.conf /etc/nginx/conf.d/default.conf
# assets/config.json nao entra na imagem: e gerado na subida a partir de NOTA_AGIL_API_URL
# (o nginx.conf desta imagem faz proxy de /api para o back) ou montado no destino (tem precedencia).
COPY --chmod=755 docker/runtime/40-nota-agil-config.sh /docker-entrypoint.d/40-nota-agil-config.sh
ENV NOTA_AGIL_API_URL=/api
EXPOSE 80
# Saudavel so com o app servindo a config de runtime (sem ela o front nao inicia).
HEALTHCHECK CMD wget -q -O /dev/null http://127.0.0.1/assets/config.json || exit 1
