# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
WORKDIR /app
ENV NG_CLI_ANALYTICS=false
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=nota-agil-hmg-npm,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY docker/dev/proxy.conf.cjs /opt/nota-agil/proxy.conf.cjs
EXPOSE 80
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1/assets/config.json').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["./node_modules/.bin/ng", "serve", "--configuration", "development", "--host", "0.0.0.0", "--port", "80", "--poll", "1000", "--proxy-config", "/opt/nota-agil/proxy.conf.cjs"]
